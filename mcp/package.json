{
  "name": "web-doom-mcp",
  "version": "2.1.0-p0",
  "private": true,
  "type": "module",
  "description": "Local DOOM MCP v2.1 P0: full topology validation, atomic multi-map authoring, closed-loop playtest/evaluation and verified episode PWAD builds",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node p0_server.js",
    "start:v2": "node geometry_server.js",
    "test:p0": "node p0_selftest.mjs",
    "prepare-geometry": "node --input-type=module -e \"import('./nodebuilder.js').then(m => m.prepareNodeBuilder()).then(s => console.log(JSON.stringify(s, null, 2)))\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
