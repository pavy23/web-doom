{
  "name": "web-doom-mcp",
  "version": "2.8.0-p2.2",
  "private": true,
  "type": "module",
  "description": "Local DOOM MCP P2.2: source-free deathmatch generation, fairness evaluation and configurable local LinuxDOOM bots layered on P2.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node p2_human_bot_server.js",
    "start:p2.2-core": "node p2_deathmatch_bot_server.js",
    "start:p2.1": "node p2_game_design_server.js",
    "start:p2.0": "node p2_blank_server.js",
    "start:p1.4": "node p1_auto_repair_server.js",
    "start:p1.3": "node p1_navigation_server.js",
    "start:p1.2": "node p1_server.js",
    "start:p0": "node p0_experiment_server.js",
    "start:p0-core": "node p0_server.js",
    "start:v2": "node geometry_server.js",
    "autoplay:e1m1": "node autoplay_stage_runner.mjs --map E1M1 --runs 3",
    "autoplay:e1m1:live": "node autoplay_stage_runner.mjs --map E1M1 --runs 1 --no-god",
    "autoplay:e1m1:jev": "node autoplay_stage_runner.mjs --map E1M1 --runs 1 --no-god --policy jev --report-dir exports/autoplay/e1m1-jev --baseline exports/autoplay/e1m1/report.json",
    "autoplay:e1m1:jev:dry": "node autoplay_stage_runner.mjs --map E1M1 --runs 1 --no-god --policy jev --jev-dry-run --report-dir exports/autoplay/e1m1-jev-dry",
    "autoplay:e1m1:jev:x3": "node autoplay_stage_runner.mjs --map E1M1 --runs 3 --no-god --policy jev --report-dir exports/autoplay/e1m1-jev-x3 --baseline exports/autoplay/e1m1/report.json",
    "autoplay:e1m1:jev:watch": "node autoplay_stage_runner.mjs --map E1M1 --runs 1 --no-god --policy jev --headed --report-dir exports/autoplay/e1m1-jev-watch --baseline exports/autoplay/e1m1/report.json",
    "autoplay:e1m1:jev:uv": "node autoplay_stage_runner.mjs --map E1M1 --runs 1 --no-god --policy jev --skill uv --report-dir exports/autoplay/e1m1-jev-uv",
    "autoplay:jev:smoke": "node autoplay_jev_smoke.mjs",
    "autoplay:dashboard": "node autoplay_dashboard.mjs exports/autoplay/e1m1-jev --baseline exports/autoplay/e1m1",
    "test:p2:deathmatch": "node p2_deathmatch_balanced_selftest.mjs",
    "test:p2:bots:runtime": "node p2_bot_runtime_selftest.mjs",
    "test:p2:human-bots:runtime": "node p2_human_bot_browser_selftest.mjs",
    "test:p2:game-design": "node p2_game_design_selftest.mjs",
    "test:p2": "node p2_blank_map_selftest.mjs",
    "test:p2:seed-runtime": "node p2_seed_runtime_selftest.mjs",
    "test:p2:runtime": "node p2_blank_map_runtime_selftest.mjs",
    "test:p1": "node p1_things_selftest.mjs",
    "test:p1:semantic": "node p1_semantic_selftest.mjs",
    "test:p1:semantic:runtime": "node p1_semantic_runtime_selftest.mjs",
    "test:p1:navigation": "node p1_navigation_selftest.mjs",
    "test:p1:navigation:runtime": "node p1_navigation_runtime_selftest.mjs",
    "test:p1:auto-repair": "node p1_auto_repair_selftest.mjs",
    "test:p1:auto-repair:runtime": "node p1_auto_repair_runtime_selftest.mjs",
    "test:p0": "node p0_selftest.mjs",
    "test:experiment": "node p0_experiment_selftest.mjs",
    "prepare-experiment": "playwright install chromium",
    "prepare-geometry": "node --input-type=module -e \"import('./nodebuilder.js').then(m => m.prepareNodeBuilder()).then(s => console.log(JSON.stringify(s, null, 2)))\"",
    "prepare-game": "node --input-type=module -e \"import('./server.js').then(m => m.prepareGameCache()).then(s => console.log(JSON.stringify(s, null, 2)))\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "playwright": "1.55.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
