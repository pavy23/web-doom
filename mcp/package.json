{
  "name": "web-doom-mcp",
  "version": "2.3.0-p1.2",
  "private": true,
  "type": "module",
  "description": "Local DOOM MCP P1.2: general THINGS plus semantic polygon, stairs, doors, lifts and sector splits on the P0 atomic multi-map pipeline",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node p1_server.js",
    "start:p0": "node p0_experiment_server.js",
    "start:p0-core": "node p0_server.js",
    "start:v2": "node geometry_server.js",
    "test:p1": "node p1_things_selftest.mjs",
    "test:p1:semantic": "node p1_semantic_selftest.mjs",
    "test:p1:semantic:runtime": "node p1_semantic_runtime_selftest.mjs",
    "test:p0": "node p0_selftest.mjs",
    "test:experiment": "node p0_experiment_selftest.mjs",
    "prepare-experiment": "playwright install chromium",
    "prepare-geometry": "node --input-type=module -e \"import('./nodebuilder.js').then(m => m.prepareNodeBuilder()).then(s => console.log(JSON.stringify(s, null, 2)))\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "1.55.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
